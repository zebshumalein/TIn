{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Ollama",
      "type": "shell",
      "command": "ollama serve",
      "options": {
        "env": {
          "OLLAMA_LOAD_TIMEOUT": "15m"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Listening on 127\\.0\\.0\\.1:11434"
        }
      }
    },
    {
      "label": "Start Web App",
      "type": "shell",
      "command": "uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Uvicorn running on http://0\\.0\\.0\\.0:8000"
        }
      }
    },
    {
      "label": "Run Full Project",
      "dependsOn": ["Start Ollama", "Start Web App"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
